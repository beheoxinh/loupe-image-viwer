<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="LpEditWindow" parent="AdwBin">
    <child>
      <object class="GtkShortcutController" id="shortcut_controller">
        <property name="scope">global</property>
      </object>
    </child>
    <property name="child">
      <object class="AdwToolbarView" id="toolbar_view">
        <property name="top-bar-style">raised</property>
        <property name="content">
          <object class="GtkOverlay">
            <property name="child">
              <object class="GtkBox">
                <property name="orientation">horizontal</property>
                <child>
                  <object class="GtkScrolledWindow" id="draw_toolbar">
                    <property name="hscrollbar-policy">never</property>
                    <property name="vscrollbar-policy">automatic</property>
                    <property name="width-request">56</property>
                    <style>
                      <class name="draw-sidebar" />
                    </style>
                    <property name="child">
                      <object class="GtkBox" id="draw_toolbar_box">
                        <property name="orientation">vertical</property>
                        <property name="spacing">6</property>
                        <property name="margin-top">8</property>
                        <property name="margin-bottom">8</property>
                        <property name="margin-start">6</property>
                        <property name="margin-end">6</property>
                        <child>
                          <object class="GtkLabel">
                            <property name="label" translatable="yes">TOOLS</property>
                            <style>
                              <class name="sidebar-heading" />
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="halign">center</property>
                            <style>
                              <class name="square-buttons" />
                              <class name="linked" />
                            </style>
                            <child>
                              <object class="GtkToggleButton" id="tool_select">
                                <property name="icon-name">edit-select-all-symbolic</property>
                                <property name="tooltip-text" translatable="yes">Select Area (S)</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkToggleButton" id="tool_move">
                                <property name="icon-name">transform-move-symbolic</property>
                                <property name="tooltip-text" translatable="yes">Move Selection (M)</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkToggleButton" id="tool_picker">
                                <property name="icon-name">color-select-symbolic</property>
                                <property name="tooltip-text" translatable="yes">Pick Color (I)</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="halign">center</property>
                            <style>
                              <class name="square-buttons" />
                              <class name="linked" />
                            </style>
                            <child>
                              <object class="GtkToggleButton" id="tool_pencil">
                                <property name="active">true</property>
                                <property name="icon-name">loupe-tool-pencil-symbolic</property>
                                <property name="tooltip-text" translatable="yes">Pencil (P)</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkToggleButton" id="tool_brush">
                                <property name="icon-name">loupe-tool-brush-symbolic</property>
                                <property name="tooltip-text" translatable="yes">Brush (B)</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkToggleButton" id="tool_eraser">
                                <property name="icon-name">loupe-tool-eraser-symbolic</property>
                                <property name="tooltip-text" translatable="yes">Eraser (E)</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkToggleButton" id="tool_highlight">
                                <property name="icon-name">loupe-tool-highlight-symbolic</property>
                                <property name="tooltip-text" translatable="yes">Highlighter (H)</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="halign">center</property>
                            <style>
                              <class name="square-buttons" />
                              <class name="linked" />
                            </style>
                            <child>
                              <object class="GtkToggleButton" id="tool_line">
                                <property name="icon-name">loupe-tool-line-symbolic</property>
                                <property name="tooltip-text" translatable="yes">Line (L)</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkToggleButton" id="tool_arrow">
                                <property name="icon-name">loupe-tool-arrow-symbolic</property>
                                <property name="tooltip-text" translatable="yes">Arrow (A) — mark up screenshots</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkToggleButton" id="tool_rectangle">
                                <property name="icon-name">loupe-tool-rectangle-symbolic</property>
                                <property name="tooltip-text" translatable="yes">Rectangle (R)</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkToggleButton" id="tool_round_rect">
                                <property name="icon-name">loupe-tool-round-rect-symbolic</property>
                                <property name="tooltip-text" translatable="yes">Rounded Rectangle (D)</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkToggleButton" id="tool_ellipse">
                                <property name="icon-name">loupe-tool-oval-symbolic</property>
                                <property name="tooltip-text" translatable="yes">Ellipse (O)</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="halign">center</property>
                            <style>
                              <class name="square-buttons" />
                              <class name="linked" />
                            </style>
                            <child>
                              <object class="GtkToggleButton" id="tool_text">
                                <property name="icon-name">loupe-tool-text-symbolic</property>
                                <property name="tooltip-text" translatable="yes">Text (T)</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkToggleButton" id="tool_bucket">
                                <property name="icon-name">loupe-tool-paint-symbolic</property>
                                <property name="tooltip-text" translatable="yes">Fill Area (F)</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkSeparator">
                            <property name="orientation">horizontal</property>
                            <property name="margin-top">2</property>
                            <property name="margin-bottom">2</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkSeparator">
                            <property name="orientation">horizontal</property>
                            <property name="margin-top">2</property>
                            <property name="margin-bottom">2</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="label" translatable="yes">EDIT</property>
                            <style>
                              <class name="sidebar-heading" />
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="halign">center</property>
                            <style>
                              <class name="square-buttons" />
                              <class name="linked" />
                            </style>
                            <child>
                              <object class="GtkButton" id="draw_undo">
                                <property name="icon-name">edit-undo-symbolic</property>
                                <property name="tooltip-text" translatable="yes">Undo (Ctrl+Z)</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="draw_redo">
                                <property name="icon-name">edit-redo-symbolic</property>
                                <property name="tooltip-text" translatable="yes">Redo (Ctrl+Shift+Z)</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="draw_cut">
                                <property name="icon-name">edit-cut-symbolic</property>
                                <property name="tooltip-text" translatable="yes">Cut Selection (Ctrl+X)</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="draw_copy">
                                <property name="icon-name">edit-copy-symbolic</property>
                                <property name="tooltip-text" translatable="yes">Copy to Clipboard (Ctrl+C)</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="draw_paste">
                                <property name="icon-name">edit-paste-symbolic</property>
                                <property name="tooltip-text" translatable="yes">Paste from Clipboard (Ctrl+V)</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkMenuButton" id="draw_filters">
                                <property name="icon-name">loupe-tool-filters-symbolic</property>
                                <property name="tooltip-text" translatable="yes">Image Filters</property>
                                <property name="popover">
                                  <object class="GtkPopover">
                                    <property name="child">
                                      <object class="GtkBox">
                                        <property name="orientation">vertical</property>
                                        <property name="spacing">6</property>
                                        <child>
                                          <object class="GtkLabel">
                                            <property name="label" translatable="yes">Apply to Selection</property>
                                            <property name="xalign">0</property>
                                            <style>
                                              <class name="dimmed" />
                                              <class name="caption" />
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkScrolledWindow">
                                            <property name="max-content-height">420</property>
                                            <property name="propagate-natural-height">true</property>
                                            <property name="hscrollbar-policy">never</property>
                                            <property name="child">
                                              <object class="GtkListBox" id="filter_list">
                                                <property name="selection-mode">none</property>
                                                <style>
                                                  <class name="boxed-list" />
                                                </style>
                                              </object>
                                            </property>
                                          </object>
                                        </child>
                                      </object>
                                    </property>
                                  </object>
                                </property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="draw_clear">
                                <property name="icon-name">edit-clear-all-symbolic</property>
                                <property name="tooltip-text" translatable="yes">Clear Drawing</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkStack" id="mode_stack">
                    <property name="transition-type">crossfade</property>
                    <property name="hexpand">true</property>
                    <property name="vexpand">true</property>
                    <child>
                      <object class="GtkStackPage">
                        <property name="name">draw</property>
                        <property name="child">
                          <object class="LpDrawCanvas" id="draw_canvas" />
                        </property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
            <child type="overlay">
              <object class="GtkRevealer" id="saving_revealer">
                <property name="transition-type">crossfade</property>
                <property name="transition-duration">500</property>
                <property name="can-target" bind-source="saving_revealer" bind-property="reveal-child" bind-flags="sync-create" />
                <property name="child">
                  <object class="AdwBin">
                    <style>
                      <class name="saving-overlay" />
                    </style>
                    <property name="child">
                      <object class="GtkRevealer" id="saving_info">
                        <property name="transition-type">crossfade</property>
                        <property name="transition-duration">500</property>
                        <property name="child">
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="valign">center</property>
                            <property name="spacing">18</property>
                            <child>
                              <object class="AdwSpinner">
                                <property name="width-request">64</property>
                                <property name="height-request">64</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="saving_status">
                                <property name="label">Preparing to Save Image</property>
                                <style>
                                  <class name="title-2" />
                                </style>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </property>
        <child type="bottom">
          <object class="GtkBox" id="draw_statusbar">
            <property name="orientation">horizontal</property>
            <property name="spacing">6</property>
            <property name="margin-start">8</property>
            <property name="margin-end">8</property>
            <property name="margin-top">4</property>
            <property name="margin-bottom">4</property>
            <style>
              <class name="draw-statusbar" />
            </style>
            <child>
              <object class="GtkLabel">
                <property name="label" translatable="yes">COLOR</property>
                <style>
                  <class name="sidebar-heading" />
                </style>
              </object>
            </child>
            <child>
              <object class="GtkColorDialogButton" id="draw_color">
                <property name="tooltip-text" translatable="yes">Drawing Color</property>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="recent_colors_box">
                <property name="orientation">horizontal</property>
                <property name="spacing">3</property>
                <property name="valign">center</property>
                <child>
                  <object class="GtkButton" id="recent_color_1">
                    <property name="tooltip-text" translatable="yes">Recent Color 1</property>
                    <style>
                      <class name="recent-color-btn" />
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="recent_color_2">
                    <property name="tooltip-text" translatable="yes">Recent Color 2</property>
                    <style>
                      <class name="recent-color-btn" />
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="recent_color_3">
                    <property name="tooltip-text" translatable="yes">Recent Color 3</property>
                    <style>
                      <class name="recent-color-btn" />
                    </style>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkSeparator">
                <property name="orientation">vertical</property>
                <property name="margin-start">4</property>
                <property name="margin-end">4</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label" translatable="yes">WIDTH</property>
                <style>
                  <class name="sidebar-heading" />
                </style>
              </object>
            </child>
            <child>
              <object class="GtkSpinButton" id="draw_width">
                <property name="width-chars">2</property>
                <property name="max-width-chars">4</property>
                <property name="numeric">true</property>
                <property name="tooltip-text" translatable="yes">Line Width</property>
                <property name="adjustment">
                  <object class="GtkAdjustment">
                    <property name="lower">1</property>
                    <property name="upper">200</property>
                    <property name="value">4</property>
                    <property name="step-increment">1</property>
                    <property name="page-increment">10</property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkSeparator">
                <property name="orientation">vertical</property>
                <property name="margin-start">4</property>
                <property name="margin-end">4</property>
              </object>
            </child>
            <child>
              <object class="GtkToggleButton" id="draw_fill">
                <property name="icon-name">emblem-filled-symbolic</property>
                <property name="label" translatable="yes">Fill Shape</property>
                <property name="tooltip-text" translatable="yes">Fill Shape</property>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="hexpand">true</property>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="zoom_controls_box">
                <property name="orientation">horizontal</property>
                <property name="spacing">2</property>
                <property name="valign">center</property>
                <style>
                  <class name="linked" />
                </style>
                <child>
                  <object class="GtkButton" id="zoom_out_btn">
                    <property name="icon-name">zoom-out-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Zoom Out (Ctrl+- / Ctrl+Scroll)</property>
                    <style>
                      <class name="zoom-btn" />
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="zoom_fit_btn">
                    <property name="label">100%</property>
                    <property name="tooltip-text" translatable="yes">Reset Zoom (Ctrl+0)</property>
                    <style>
                      <class name="zoom-btn" />
                      <class name="zoom-level-label" />
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="zoom_in_btn">
                    <property name="icon-name">zoom-in-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Zoom In (Ctrl++ / Ctrl+Scroll)</property>
                    <style>
                      <class name="zoom-btn" />
                    </style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child type="top">
          <object class="AdwHeaderBar">
            <property name="show-start-title-buttons">true</property>
            <property name="show-end-title-buttons">true</property>
            <binding name="show-end-title-buttons">
              <lookup name="not-fullscreened" type="LpWindow">
                <lookup name="root">LpEditWindow</lookup>
              </lookup>
            </binding>
            <binding name="show-start-title-buttons">
              <lookup name="not-fullscreened" type="LpWindow">
                <lookup name="root">LpEditWindow</lookup>
              </lookup>
            </binding>
            <property name="title-widget">
              <object class="GtkBox">
                <child>
                  <object class="GtkLabel">
                    <property name="label" translatable="yes">Draw</property>
                    <style>
                      <class name="title" />
                    </style>
                  </object>
                </child>
              </object>
            </property>
            <child type="start">
              <object class="GtkButton" id="cancel">
                <property name="label" translatable="yes">_Cancel</property>
                <property name="use-underline">true</property>
                <property name="action-name">edit.cancel</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkMenuButton" id="save">
                <property name="label" translatable="yes">_Save</property>
                <property name="use-underline">true</property>
                <style>
                  <class name="suggested-action" />
                </style>
                <property name="popover">
                  <object class="GtkPopover">
                    <style>
                      <class name="menu" />
                    </style>
                    <property name="child">
                      <object class="GtkListBox">
                        <property name="selection-mode">none</property>
                        <child>
                          <object class="GtkListBoxRow" id="save_copy">
                            <property name="action-name">edit.save-copy</property>
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">_Save As…</property>
                                    <property name="use-underline">true</property>
                                    <property name="xalign">0</property>
                                    <property name="mnemonic-widget">save_copy</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Keep original and create a new file</property>
                                    <property name="xalign">0</property>
                                    <style>
                                      <class name="dimmed" />
                                      <class name="caption" />
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkListBoxRow" id="save_overwrite">
                            <property name="action-name">edit.save-overwrite</property>
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">_Replace Original</property>
                                    <property name="use-underline">true</property>
                                    <property name="xalign">0</property>
                                    <property name="mnemonic-widget">save_overwrite</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Original image will be moved to the trash</property>
                                    <property name="xalign">0</property>
                                    <style>
                                      <class name="dimmed" />
                                      <class name="caption" />
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </property>
  </template>
</interface>